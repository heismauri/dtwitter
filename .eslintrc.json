{
  "env": {
    "jest/globals": true,
    "worker": true
  },
  "extends": [
    "airbnb-base"
  ],
  "ignorePatterns": [
    "deprecated/*.js",
    "dist/*.js"
  ],
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "plugins": [
    "jest"
  ],
  "root": true,
  "rules": {
    "arrow-body-style": "off",
    "comma-dangle": [
      "error",
      "never"
    ],
    "max-len": [
      "error",
      {
        "code": 120,
        "tabWidth": 2
      }
    ],
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-param-reassign": "off",
    "no-underscore-dangle": "off",
    "no-unexpected-multiline": "error",
    "no-unused-vars": "warn",
    "quote-props": [
      "error",
      "consistent"
    ],
    "quotes": [
      "error",
      "single",
      {
        "avoidEscape": true
      }
    ]
  }
}
