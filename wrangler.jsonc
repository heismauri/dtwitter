{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Set this to today's date
  "compatibility_date": "2026-07-31",
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "data",
      "id": "1839c632b63746acbb847ea3f037ca0c",
      "preview_id": "df76d8aa5ee745809d32e650d0195f42"
    }
  ],
  "limits": {
    "cpu_ms": 10
  },
  "main": "src/index.ts",
  "minify": true,
  "name": "dtwitter",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "secrets": {
    "required": ["TOKEN"]
  },
  "vars": {
    "MAINTENANCE": "false"
  },
  "workers_dev": false
}
