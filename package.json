{
  "name": "dtwitter",
  "version": "4.1.1",
  "description": "Download photos, videos and HQ GIFs from a public tweet",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/heismauri/dtwitter.git"
  },
  "author": "heismauri",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/heismauri/dtwitter/issues"
  },
  "homepage": "https://dtwitter.heismauri.com",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "pnpm build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "types": "wrangler types --strict-vars=false",
    "deploy": "pnpm lint && pnpm test && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dotenv": "16.4.5",
    "eslint": "10.8.0",
    "jest": "29.7.0",
    "jest-environment-miniflare": "2.14.4",
    "miniflare": "3.20241011.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "undici": "^5.28.4",
    "wrangler": "4.118.0"
  }
}
