{
  "name": "dtwitter",
  "version": "4.1.1",
  "description": "Download photos, videos and HQ GIFs from a public tweet",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/heismauri/dtwitter.git"
  },
  "author": "heismauri",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/heismauri/dtwitter/issues"
  },
  "homepage": "https://dtwitter.heismauri.com",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --strict-vars=false",
    "deploy": "tsc && eslint . && vitest run && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
