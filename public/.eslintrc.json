{
  "env": {
    "browser": true
  },
  "extends": "airbnb-base",
  "globals": {
    "currentVersion": "readonly"
  },
  "rules": {
    "arrow-body-style": "off",
    "comma-dangle": [
      "error",
      "never"
    ],
    "max-len": [
      "error",
      {
        "code": 120,
        "tabWidth": 2
      }
    ],
    "no-alert": "off",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-param-reassign": "off",
    "no-unexpected-multiline": "error",
    "no-unused-vars": "warn",
    "quote-props": [
      "error",
      "consistent"
    ],
    "quotes": [
      "error",
      "single",
      {
        "avoidEscape": true
      }
    ]
  }
}
