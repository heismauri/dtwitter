{
  "env": {
    "browser": true
  },
  "extends": "airbnb-base",
  "globals": {
    "currentVersion": "readonly"
  },
  "rules": {
    "arrow-body-style": "off",
    "comma-dangle": [
      "warn",
      "never"
    ],
    "max-len": [
      "error",
      {
        "code": 120,
        "tabWidth": 2
      }
    ],
    "no-alert": "off",
    "no-console": "warn",
    "no-new-object": "off",
    "no-param-reassign": "off",
    "no-unused-vars": "off",
    "quote-props": [
      "error",
      "consistent"
    ],
    "quotes": [
      "error",
      "single"
    ]
  }
}
