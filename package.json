{
  "name": "dtwitter",
  "version": "4.1.1",
  "description": "Download photos, videos and HQ GIFs from a public tweet",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/heismauri/dtwitter.git"
  },
  "author": "heismauri",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/heismauri/dtwitter/issues"
  },
  "homepage": "https://dtwitter.heismauri.com",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:vite": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev": "pnpm run dev:worker & pnpm run dev:vite",
    "build": "tsc -b app/tsconfig.json && vite build",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest",
    "deploy": "pnpm run build && tsc && eslint . && vitest run && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
